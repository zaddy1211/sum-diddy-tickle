-- ==================== GLOBAL SAFETY PATCH (Delta + All) ====================
local executorName = (identifyexecutor and identifyexecutor()) or (syn and syn.getexecutor and syn.getexecutor()) or ""
local IS_DELTA = string.find(string.lower(executorName), "delta") ~= nil
local IS_SYNAPSE = string.find(string.lower(executorName), "synapse") ~= nil
local IS_SW = string.find(string.lower(executorName), "script%-ware") ~= nil

if IS_DELTA then
    print("[KZ Safety] Delta detected. Activating safe-mode patches.")
else
    print("[KZ Safety] Safe-mode active for all executors.")
end

-- Global: neutralize sethiddenproperty for EVERYONE - this is what gets game-banned in FF3
-- We keep original in getgenv for debugging but make the global a no-op
do
    local function noop(...) return end
    if sethiddenproperty then
        if getgenv then getgenv().__kz_orig_sethidden = sethiddenproperty end
        sethiddenproperty = noop
    end
    if sethiddenprop then
        if getgenv then getgenv().__kz_orig_sethiddenprop = sethiddenprop end
        sethiddenprop = noop
    end
    if getgenv then
        if getgenv().sethiddenproperty then getgenv().sethiddenproperty = noop end
        if getgenv().sethiddenprop then getgenv().sethiddenprop = noop end
    end
end

-- Global throttle for firetouchinterest - works same but safer, prevents burst flags
do
    if firetouchinterest then
        local _orig_fti = firetouchinterest
        local _lastFTI = 0
        local _ftiCooldown = 0.08 -- 80ms global, same feel but no spam
        if getgenv then getgenv().__kz_orig_fti = _orig_fti end
        local function throttled_fti(a, b, t)
            local now = tick()
            if now - _lastFTI < _ftiCooldown then return end
            _lastFTI = now
            return _orig_fti(a, b, t)
        end
        firetouchinterest = throttled_fti
        if getgenv then getgenv().firetouchinterest = throttled_fti end
    end
end
